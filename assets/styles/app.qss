/* Hoja de estilos Qt (QSS) separada del código Python. */

QWidget {
    background-color: #0b1220;
    color: #e6f3ff;
    font-family: 'Segoe UI', Arial, sans-serif;
}

QDialog#progressDialog {
    background-color: #0b1220;
    border: 1px solid #00e5ff;
    border-radius: 10px;
}

QLabel.title {
    color: #00e5ff;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QLabel.subtitle {
    color: #7dd3fc;
    font-size: 16px;
    font-weight: 600;
    opacity: 0.9;
}

QLabel.info {
    color: #7dd3fc;
    opacity: 0.95;
}

QPushButton#roleButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                 stop:0 #111a2b, stop:1 #162235);
    color: #e6f3ff;
    border: 2px solid #00e5ff;
    border-radius: 10px;
    padding: 26px 36px;
}

QPushButton#roleButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                 stop:0 #162235, stop:1 #111a2b);
    border-color: #7dd3fc;
}

QPushButton#roleButton:pressed {
    background: #162235;
    border-color: #7dd3fc;
}

QPushButton.accent {
    background-color: #00e5ff;
    color: #0b1220;
    border: 0;
    padding: 8px 16px;
    font-weight: 600;
    border-radius: 8px;
}

QPushButton.accent:hover {
    background-color: #7dd3fc;
}

QPushButton.danger {
    background-color: #ff4444;
    color: #ffffff;
    border: 0;
    padding: 8px 16px;
    font-weight: 600;
    border-radius: 8px;
}

QPushButton.danger:hover {
    background-color: #ff6666;
}

QPushButton.warning {
    background-color: #ff8800;
    color: #ffffff;
    border: 0;
    padding: 8px 16px;
    font-weight: 600;
    border-radius: 8px;
}

QPushButton.warning:hover {
    background-color: #ffaa00;
}

QTextEdit, QLineEdit {
    background-color: #111a2b;
    color: #e6f3ff;
    border: 1px solid #00e5ff;
    border-radius: 6px;
}

QTreeWidget {
    background-color: #162235;
    color: #e6f3ff;
    border: 0;
}

QTreeWidget::item:selected {
    background-color: #00e5ff;
    color: #0b1220;
}
